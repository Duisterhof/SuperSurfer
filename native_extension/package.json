{
  "name": "native-workflows",
  "displayName": "SuperSurfer",
  "publisher": "supersurfer",
  "version": "0.1.43",
  "description": "Your persistent SuperSurfer agents in VS Code native Chat, with Surfboards and shared history.",
  "engines": {
    "vscode": "^1.139.0"
  },
  "main": "./extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "license": "GPL-2.0-or-later",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "supersurferNative.newChat",
        "title": "SuperSurfer: New Chat in This Folder",
        "icon": "$(add)"
      },
      {
        "command": "supersurferNative.open",
        "title": "SuperSurfer: Open Surfboard",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "supersurferNative.attach",
        "title": "SuperSurfer: Attach Surfboard to Native Chat",
        "icon": "$(link)"
      },
      {
        "command": "supersurferNative.queue",
        "title": "SuperSurfer: GPU Queue"
      },
      {
        "command": "supersurferNative.refresh",
        "title": "SuperSurfer: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "supersurferNative.openChat",
        "title": "SuperSurfer: Open Agent Chat"
      },
      {
        "command": "supersurferNative.detach",
        "title": "SuperSurfer: Detach Workflow"
      },
      {
        "command": "supersurferNative.stopAgent",
        "title": "SuperSurfer: Stop Agent"
      },
      {
        "command": "supersurferNative.openChatBeside",
        "title": "SuperSurfer: Open Agent to the Side"
      },
      {
        "command": "supersurferNative.agentDecision",
        "title": "SuperSurfer: Answer Agent Request"
      },
      {
        "command": "supersurferNative.answerQuestion",
        "title": "SuperSurfer: Answer Question"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "supersurferNative",
          "title": "SuperSurfer",
          "icon": "media/surfer.svg"
        }
      ]
    },
    "views": {
      "supersurferNative": [
        {
          "id": "supersurferNative.sessions",
          "name": "Agents"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "supersurferNative.newChat",
          "when": "view == supersurferNative.sessions",
          "group": "navigation@0"
        },
        {
          "command": "supersurferNative.attach",
          "when": "view == supersurferNative.sessions",
          "group": "navigation"
        },
        {
          "command": "supersurferNative.refresh",
          "when": "view == supersurferNative.sessions",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "supersurferNative.open",
          "when": "view == supersurferNative.sessions && viewItem == serviceAgent",
          "group": "inline"
        },
        {
          "command": "supersurferNative.openChatBeside",
          "when": "view == supersurferNative.sessions && viewItem =~ /^service/",
          "group": "1_chat"
        },
        {
          "command": "supersurferNative.stopAgent",
          "when": "view == supersurferNative.sessions && viewItem =~ /^service/",
          "group": "2_control"
        }
      ],
      "commandPalette": [
        {
          "command": "supersurferNative.agentDecision",
          "when": "false"
        },
        {
          "command": "supersurferNative.answerQuestion",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "SuperSurfer",
      "properties": {
        "supersurferNative.stateDirectory": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Existing SuperSurfer service directory on this host. Auto-detected when empty."
        },
        "supersurferNative.endpointFile": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Agent Host endpoint registry JSON on this host. Auto-detected when there is one live endpoint."
        }
      }
    },
    "chatSessions": [
      {
        "type": "supersurfer",
        "name": "supersurfer",
        "displayName": "SuperSurfer",
        "description": "Persistent agents on this host",
        "requiresCopilotSignIn": false,
        "requiresCustomModels": true,
        "capabilities": {
          "supportsFileAttachments": true,
          "supportsImageAttachments": false,
          "supportsToolAttachments": false,
          "supportsMCPAttachments": false
        },
        "welcomeTitle": "Work with your persistent agents",
        "welcomeMessage": "Your chats, files, and Surfboards stay on the host.",
        "supportsAutoModel": false
      }
    ],
    "chatParticipants": [
      {
        "id": "supersurfer",
        "name": "supersurfer",
        "fullName": "SuperSurfer",
        "description": "Talk to your persistent agents."
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "supersurfer",
        "displayName": "SuperSurfer"
      }
    ]
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "enabledApiProposals": [
    "chatSessionsProvider",
    "chatParticipantAdditions",
    "chatParticipantPrivate",
    "chatProvider"
  ]
}
