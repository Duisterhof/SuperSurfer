{
  "name": "supersurfer",
  "productName": "SuperSurfer",
  "version": "0.1.43",
  "description": "A quiet workspace for research, agents, and compute.",
  "private": true,
  "main": "desktop/main.cjs",
  "author": "SuperSurfer",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "start": "node scripts/build-remote.cjs && electron .",
    "test": "python3 -m unittest discover -s tests -v && node --test tests/*.test.cjs",
    "package:mac": "node scripts/package.cjs",
    "package:linux": "SUPERSURFER_PLATFORM=linux node scripts/package.cjs",
    "bundle:remote": "node scripts/build-remote.cjs",
    "test:browser": "node scripts/check-browser.cjs",
    "test:skills": "python3 scripts/check-agent-skills.py",
    "package:vscode": "python3 scripts/package-native-extension.py"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "dictionary-en": "4.0.0",
    "electron": "44.5.1",
    "esbuild": "0.28.2",
    "katex": "0.18.7",
    "monaco-editor": "0.57.0",
    "nspell": "2.1.5",
    "pdfjs-dist": "6.4.299",
    "playwright": "1.63.0"
  },
  "workspaces": [
    "native_extension"
  ]
}
