{
  "name": "workspace",
  "displayName": "SuperSurfer workspace",
  "publisher": "supersurfer",
  "version": "0.1.42",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "commands": [
      {
        "command": "supersurfer.askAgent",
        "title": "Add selection to SuperSurfer chat"
      },
      {
        "command": "supersurfer.saveDraft",
        "title": "Save SuperSurfer draft"
      }
    ],
    "keybindings": [
      {
        "command": "supersurfer.saveDraft",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "editorTextFocus && config.supersurfer.session"
      },
      {
        "command": "supersurfer.askAgent",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus"
      },
      {
        "command": "supersurfer.askAgent",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "workbench.action.closeSidebar",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "config.supersurfer.editorOnly"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "supersurfer.askAgent",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "SuperSurfer",
      "properties": {
        "supersurfer.session": {
          "type": "string",
          "scope": "window",
          "default": "",
          "description": "SuperSurfer pane identity."
        },
        "supersurfer.latexSpellcheck": {
          "type": "boolean",
          "default": true,
          "description": "Check English spelling in LaTeX prose only."
        },
        "supersurfer.dictionary": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Workspace spelling dictionary."
        },
        "supersurfer.editorOnly": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Use the compact editor surface inside SuperSurfer."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "supersurfer.pdf",
        "displayName": "SuperSurfer PDF viewer",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "license": "GPL-2.0-or-later"
}
